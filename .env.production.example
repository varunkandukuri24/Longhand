# Apex domain (no protocol). Writer pages live at {handle}.{ROOT_DOMAIN}.
ROOT_DOMAIN=example.com
# Public site URL Auth.js uses for magic-link callbacks (must be https in production).
AUTH_URL=https://example.com
# Random secret for Auth.js session encryption (openssl rand -base64 32).
AUTH_SECRET=
# Trust the Host header behind Caddy (required on the droplet).
AUTH_TRUST_HOST=true
# Postgres password for the db service and DATABASE_URL.
POSTGRES_PASSWORD=
# App connection string on the Compose network (user longhand, db longhand).
DATABASE_URL=postgres://longhand:${POSTGRES_PASSWORD}@db:5432/longhand
# Resend API key for magic-link email (DigitalOcean blocks SMTP).
AUTH_RESEND_KEY=
# Google OAuth (optional). When both are set, "Continue with Google" appears on sign-in.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# From address Resend will send as (must be a verified domain in Resend).
EMAIL_FROM=Longhand <noreply@example.com>
# Optional public piece URL shown as "See an example" on the guest editor.
EXAMPLE_PIECE_URL=
# DigitalOcean API token for Caddy's DNS-01 wildcard certificate.
DO_AUTH_TOKEN=
# Contact email for Let's Encrypt / ACME registration.
ACME_EMAIL=admin@example.com
