# Vercel environment variables for Longhand.
# Set these in the Vercel project. Preview env inherits Production unless
# a variable is marked production-only.

# Set by the Neon Marketplace integration (do not paste these by hand):
#   DATABASE_URL            pooled connection (PgBouncer); used by the app
#   DATABASE_URL_UNPOOLED   direct connection; used by migrations at build

# Random secret for Auth.js session encryption (openssl rand -base64 32).
AUTH_SECRET=

# Production-only. Public site URL Auth.js uses for magic-link callbacks.
# Unset on previews so Auth.js uses the request host (trustHost is on).
AUTH_URL=https://example.com

# Production-only. Apex host (no protocol). Writer pages live at {handle}.{ROOT_DOMAIN}.
# Unset on previews: writer pages are served at /u/{handle} on the preview URL.
ROOT_DOMAIN=example.com

# Resend API key for magic-link email. Needed on Production and Preview
# (not production-only): previews have no Google sign-in, and next build
# imports auth for every route that uses a session.
AUTH_RESEND_KEY=

# Production-only. Google OAuth. Previews hide Google sign-in even if these are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# From address Resend will send as (must be a verified domain in Resend).
EMAIL_FROM=Longhand <noreply@example.com>

# Vercel Cron Authorization: Bearer $CRON_SECRET (openssl rand -base64 32).
CRON_SECRET=

# Optional public piece URL shown as "See an example" on the guest editor.
EXAMPLE_PIECE_URL=

# Comma-separated emails that can open /stats (case-insensitive). Production only.
ADMIN_EMAILS=

# Guest rate limits (positive integers). Preview deployments multiply the
# two per-IP limits by 10; word/char/nudge caps stay as set.
# New guest pieces allowed per IP address per day (default 20).
GUEST_CREATE_PER_IP_DAY=20
# Event-batch saves allowed per IP address per hour (default 2000).
GUEST_BATCH_PER_IP_HOUR=2000
# Max words on a guest piece before sign-in is required (default 500).
GUEST_WORD_LIMIT=500
# Max characters on a guest piece before sign-in is required (default 4000).
GUEST_CHAR_LIMIT=4000
# Word count at which the soft sign-in nudge appears (default 50).
GUEST_NUDGE_WORDS=50

# Retired Docker/droplet variables. Only used by the old Compose setup
# (POSTGRES_PASSWORD, DO_AUTH_TOKEN, ACME_EMAIL); not set on Vercel.
