# Apex host for the app (no protocol). Writer pages live at {handle}.{ROOT_DOMAIN}.
ROOT_DOMAIN=localhost:3000
EMAIL_SERVER=smtp://localhost:1025
EMAIL_FROM=Longhand <noreply@localhost>
