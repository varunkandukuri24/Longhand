{$ROOT_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000
}

*.{$ROOT_DOMAIN} {
	tls {
		dns digitalocean {env.DO_AUTH_TOKEN}
		propagation_delay 90s
		propagation_timeout 10m
		resolvers 1.1.1.1 8.8.8.8
	}

	encode zstd gzip

	@www host www.{$ROOT_DOMAIN}
	redir @www https://{$ROOT_DOMAIN}{uri} 308

	reverse_proxy app:3000
}
